# Credenciales de Supabase para la sincronización entre dispositivos.
# Copiar este archivo a .env y completar con los datos del proyecto
# (Supabase → Project Settings → API). Sin esto la app funciona igual,
# guardando los gastos solo en el dispositivo.
#
# La anon key es pública por diseño: viaja dentro de la app. Lo que protege
# los datos es el código del hogar, que no se guarda acá.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
